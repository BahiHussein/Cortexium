{
  "name": "cortexium",
  "version": "1.0.0",
  "description": "A high-performance, reliable Node.js library for inter-service communication using NATS. Topic-based pub/sub + callback RPC with built-in service discovery, middleware, and streaming.",
  "main": "index.js",
  "scripts": {
    "test": "node test/reliability.js",
    "test:reliability": "node test/reliability.js",
    "test:performance": "node test/performance.js",
    "benchmark": "node performance-test.js",
    "diagnose": "node diagnostics.js"
  },
  "author": "Bahi Hussein",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BahiHussein/Cortexium.git"
  },
  "keywords": [
    "nats",
    "rpc",
    "microservices",
    "message-bus",
    "real-time",
    "pubsub",
    "jetstream",
    "service-discovery",
    "middleware"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "nanoid": "^3.3.4",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "event-loop-lag": "^1.4.0"
  }
}
